# Production environment - copy to .env.production on the SERVER only.
# Never commit .env.production. It is gitignored.
# Values live in Bitwarden. Copy them across; do not paste into git.

# ---------------------------------------------------------------------
# Domain / TLS
# ---------------------------------------------------------------------
# The hostname Caddy will terminate TLS for. Let's Encrypt issues a cert
# for exactly this name, so DNS (or nip.io / sslip.io) must point at this
# server's IP before the container starts.
#
# Staging (no real DNS): <ip-with-dashes>.nip.io - e.g. 178-104-239-168.nip.io
# Production:            magenta-blumen.ch
DOMAIN=

# ---------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------
# Used both by the postgres container (as its init env) AND composed into
# DATABASE_URL for the app container (see docker-compose.prod.yml).
POSTGRES_USER=magenta
POSTGRES_DB=magenta_blumen
# Generate ONCE on the server, save to Bitwarden as `magenta-blumen prod postgres`:
#   openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------
# AUTH_URL: full public URL of the site, no trailing slash.
AUTH_URL=https://
# Session-signing key. Generate ONCE, save to your secrets file:
#   openssl rand -base64 48
AUTH_SECRET=

# ---- Admin login (single shared account) ----
# Sandra + owner share this login. Two people, no reason yet for
# per-user accounts. When we need an audit trail, migrate to a DB-
# backed admin_user table (schema change - flag first).
ADMIN_EMAIL=
# bcrypt hash - generate with:
#   npx tsx scripts/hash-password.ts 'chosen password'
# The command prints the hash. Paste it below. NEVER put the raw
# password here.
#
# !! DOCKER COMPOSE GOTCHA !!
# Compose interpolates ${VAR} and $VAR in env_file values by default.
# The bcrypt hash contains literal $ chars ($2b$12$...) that must be
# ESCAPED by doubling every $. Otherwise Compose expands them to empty
# strings and the container sees a mangled/empty hash - login always
# fails silently with "E-Mail oder Passwort ist falsch".
#
# So paste:  $$2b$$12$$abcxyz...   (every $ doubled)
# NOT:       $2b$12$abcxyz...      (raw hash - broken)
#
# Compose collapses $$ back to $ when injecting into the container, so
# the app sees the correct single-$ hash at runtime.
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------
# Sentry (from Bitwarden: `magenta-blumen Sentry`)
# ---------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=magenta-blumen-kishta
SENTRY_PROJECT=magenta-blumen-web
# Used at BUILD time to upload source maps. Get it from Sentry:
# User avatar (top-left) -> User Auth Tokens -> Create New Token
# Scopes: project:releases + project:read
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------
# Cloudflare R2 (from Bitwarden: `magenta-blumen R2 backup`)
# ---------------------------------------------------------------------
# S3-compatible endpoint URL. Full URL including https://.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=magenta-blumen-backups
