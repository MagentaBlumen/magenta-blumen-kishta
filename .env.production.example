# Production environment - copy to .env.production on the SERVER only.
# Never commit .env.production. It is gitignored.
# Values live in Bitwarden. Copy them across; do not paste into git.

# ---------------------------------------------------------------------
# Domain / TLS
# ---------------------------------------------------------------------
# The hostname Caddy will terminate TLS for. Let's Encrypt issues a cert
# for exactly this name, so DNS (or nip.io / sslip.io) must point at this
# server's IP before the container starts.
#
# Staging (no real DNS): <ip-with-dashes>.nip.io - e.g. 178-104-239-168.nip.io
# Production:            magenta-blumen.ch
DOMAIN=

# ---------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------
# Used both by the postgres container (as its init env) AND composed into
# DATABASE_URL for the app container (see docker-compose.prod.yml).
POSTGRES_USER=magenta
POSTGRES_DB=magenta_blumen
# Generate ONCE on the server, save to Bitwarden as `magenta-blumen prod postgres`:
#   openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------
# AUTH_URL: full public URL of the site, no trailing slash.
AUTH_URL=https://
# Session-signing key. Generate ONCE, save to your secrets file:
#   openssl rand -base64 48
AUTH_SECRET=

# ---- Admin login (single shared account) ----
# Sandra + owner share this login. Two people, no reason yet for
# per-user accounts. When we need an audit trail, migrate to a DB-
# backed admin_user table (schema change - flag first).
ADMIN_EMAIL=
# bcrypt hash - generate with:
#   npx tsx scripts/hash-password.ts 'chosen password'
# The command prints the hash. Paste it below. NEVER put the raw
# password here.
#
# !! DOLLAR-SIGN GOTCHA - APPLIES ON PROD (Docker Compose) !!
# Compose interpolates ${VAR} and $VAR in env_file values. Bcrypt
# hashes look like $2b$12$... - each $ triggers an expansion, and the
# container sees an empty/mangled hash. Login fails silently with a
# generic "E-Mail oder Passwort ist falsch".
#
# Fix: DOUBLE every $ in the hash.
#   paste:  $$2b$$12$$abcxyz...   (every $ doubled)
#   NOT:    $2b$12$abcxyz...      (raw - broken)
# Compose collapses $$ back to $ when injecting into the container.
# Verify with:
#   docker exec magenta-blumen-app printenv ADMIN_PASSWORD_HASH | wc -c
# Should print 61 (60 chars + newline).
#
# !! DIFFERENT SYNTAX FOR .env.local (Next.js dev, not this file) !!
# Local dev uses .env.local which is read by dotenv-expand, and it
# uses a different escape: wrap the whole value in SINGLE quotes.
#   .env.local:  ADMIN_PASSWORD_HASH='$2b$12$abcxyz...'
#   .env.production (this file):  ADMIN_PASSWORD_HASH=$$2b$$12$$abcxyz...
# Same problem, two different fixes. Only .env.production uses $$.
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------
# Sentry (from Bitwarden: `magenta-blumen Sentry`)
# ---------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ORG=magenta-blumen-kishta
SENTRY_PROJECT=magenta-blumen-web
# Used at BUILD time to upload source maps. Get it from Sentry:
# User avatar (top-left) -> User Auth Tokens -> Create New Token
# Scopes: project:releases + project:read
SENTRY_AUTH_TOKEN=

# ---------------------------------------------------------------------
# Cloudflare R2 - BACKUPS bucket
# ---------------------------------------------------------------------
# S3-compatible endpoint URL. Full URL including https://. Same account
# endpoint is reused by the images bucket below.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=magenta-blumen-backups

# ---------------------------------------------------------------------
# Cloudflare R2 - IMAGES bucket (product photos)
# ---------------------------------------------------------------------
# SEPARATE bucket from backups. Product images are PUBLIC via the
# r2.dev subdomain (or a Cloudflare-Workers-backed custom domain
# later). Backups are private. Different blast radius, different
# rotation - keep the credentials separate too.
#
# Setup (once):
#   1. Cloudflare R2 → Create bucket `magenta-blumen-images` in EU
#   2. Bucket → Settings → Public access → R2.dev subdomain → allow
#   3. Copy the pub-<hash>.r2.dev URL to R2_IMAGES_PUBLIC_URL below
#   4. Manage R2 API Tokens → create Admin Read & Write token scoped
#      to just this bucket (bucket-scoped Object R&W silently 403s
#      on writes - Cloudflare bug documented in project memory)
#   5. Paste the two keys below
R2_IMAGES_BUCKET=magenta-blumen-images
R2_IMAGES_PUBLIC_URL=
R2_IMAGES_ACCESS_KEY_ID=
R2_IMAGES_SECRET_ACCESS_KEY=
