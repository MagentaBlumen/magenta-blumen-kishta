# Caddy serves TLS for {$DOMAIN}, proxies everything to the app container.
# Auto-issues a Let's Encrypt cert on first request. Persists it in
# /data (volume caddy_data) so restarts don't hit rate limits.
#
# $DOMAIN comes from .env.production via docker-compose.prod.yml.
# Examples:
#   staging: 178-104-239-168.nip.io
#   prod:    magenta-blumen.ch

{$DOMAIN} {
    encode gzip zstd

    # Reverse proxy to the Next.js app on the internal network
    reverse_proxy app:3000

    # Security headers
    header {
        # Force HTTPS forever
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        # Basic XSS / clickjacking / content-type sniffing protections
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Remove server-fingerprinting header Caddy adds by default
        -Server
    }

    # Access logs to a rotating file inside the caddy container.
    # docker logs magenta-blumen-caddy also shows these.
    log {
        output stdout
        format json
    }
}
